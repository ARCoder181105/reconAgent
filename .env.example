# ReconAgent — environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env` (gitignored).
# The app reads these via backend/config.py.

# --- LLM (Stage 5 async tie-break). Only needed for LLM matching. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Data generator ---
RECON_SEED=42
RECON_BATCH_SIZE=60            # target settlement record count (>=50)

# --- Database ---
RECON_DB_PATH=backend/data/recon.sqlite3

# --- Scoring ---
# Weight of a false positive relative to a false negative (default 3.0 = caution)
RECON_FP_WEIGHT=3.0

# --- Logging ---
LOG_LEVEL=INFO
